FROM node:24.15.0-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tooling
COPY infra/migrator/package.json infra/migrator/package-lock.json ./
RUN npm ci --no-audit --no-fund && npm cache clean --force
COPY infra/prisma-migrator.config.ts ./infra/prisma-migrator.config.ts
COPY infra/migrator/entrypoint.sh ./entrypoint.sh
COPY prisma/schema.prisma ./prisma/schema.prisma
COPY prisma/migrations ./prisma/migrations
RUN chmod 755 /tooling/entrypoint.sh

USER node
ENTRYPOINT ["/tooling/entrypoint.sh"]
CMD ["--help"]
