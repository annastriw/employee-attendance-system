PORT=3002
# Auth Service origin used to verify bearer sessions on every request.
AUTH_SERVICE_URL=http://127.0.0.1:3001
# EMPLOYEE_DATABASE_URL is generated into .env.database by `pnpm db:grants`.
# Remote database connections require a verified CA file.
EMPLOYEE_DATABASE_CA_FILE=

# Dedicated internal provisioning authentication, 32 random bytes as hex.
PROVISIONING_SERVICE_SECRET=
