generator client {
  provider     = "prisma-client"
  output       = "../packages/database/src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum AuthRole {
  ADMIN_HRD
  EMPLOYEE
}

enum AuthAccountStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model AuthAccount {
  id                 String            @id @default(uuid()) @db.Char(36)
  email              String            @unique @db.VarChar(254)
  employeeId         String?           @unique @map("employee_id") @db.Char(36)
  passwordHash       String            @map("password_hash") @db.VarChar(60)
  role               AuthRole
  status             AuthAccountStatus @default(INACTIVE)
  mustChangePassword Boolean           @default(true) @map("must_change_password")
  passwordChangedAt  DateTime?         @map("password_changed_at") @db.DateTime(3)
  archivedAt         DateTime?         @map("archived_at") @db.DateTime(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  sessions           AuthSession[]
  provisioning       AuthProvisioning?
  emailChanges       AuthEmailChange[]

  @@index([role, status])
  @@map("auth_accounts")
}

model AuthSession {
  id               String      @id @default(uuid()) @db.Char(36)
  accountId        String      @map("account_id") @db.Char(36)
  refreshTokenHash String      @unique @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime    @map("expires_at") @db.DateTime(3)
  revokedAt        DateTime?   @map("revoked_at") @db.DateTime(3)
  createdAt        DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  account          AuthAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([accountId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthAuditLog {
  id              String   @id @default(uuid()) @db.Char(36)
  actorAccountId  String?  @map("actor_account_id") @db.Char(36)
  targetAccountId String?  @map("target_account_id") @db.Char(36)
  action          String   @db.VarChar(80)
  reason          String?  @db.VarChar(500)
  requestId       String?  @map("request_id") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([targetAccountId, createdAt])
  @@index([actorAccountId, createdAt])
  @@map("auth_audit_logs")
}

enum EmpMasterStatus {
  ACTIVE
  INACTIVE
}

model EmpDepartment {
  id        String          @id @default(uuid()) @db.Char(36)
  name      String          @db.VarChar(120)
  code      String          @unique @db.VarChar(40)
  status    EmpMasterStatus @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  employees EmpEmployee[]

  @@unique([name])
  @@index([status, name])
  @@map("emp_departments")
}

model EmpPosition {
  id        String          @id @default(uuid()) @db.Char(36)
  name      String          @db.VarChar(120)
  code      String          @unique @db.VarChar(40)
  status    EmpMasterStatus @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  employees EmpEmployee[]

  @@unique([name])
  @@index([status, name])
  @@map("emp_positions")
}

model EmpAuditLog {
  id             String   @id @default(uuid()) @db.Char(36)
  actorAccountId String?  @map("actor_account_id") @db.Char(36)
  entityType     String   @map("entity_type") @db.VarChar(40)
  entityId       String?  @map("entity_id") @db.Char(36)
  action         String   @db.VarChar(80)
  reason         String?  @db.VarChar(500)
  requestId      String?  @map("request_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([entityType, entityId, createdAt])
  @@index([actorAccountId, createdAt])
  @@map("emp_audit_logs")
}

enum EmpEmployeeStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum EmpProvisioningStatus {
  PENDING
  COMPLETED
  FAILED
}

enum EmpProvisioningPhase {
  PREPARE
  PUBLISH
  FINALIZE
}

model EmpEmployee {
  id           String            @id @default(uuid()) @db.Char(36)
  nik          String            @unique @db.VarChar(40)
  name         String            @db.VarChar(120)
  phone        String?           @db.VarChar(30)
  departmentId String            @map("department_id") @db.Char(36)
  positionId   String            @map("position_id") @db.Char(36)
  startDate    DateTime          @map("start_date") @db.Date
  status       EmpEmployeeStatus @default(INACTIVE)
  accountEmail String?           @map("account_email") @db.VarChar(254)
  ready        Boolean           @default(false)
  archivedAt   DateTime?         @map("archived_at") @db.DateTime(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  department   EmpDepartment     @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  position     EmpPosition       @relation(fields: [positionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  provisioning EmpProvisioning?
  emailChanges EmpEmailChange[]
  lifecycleChanges EmpLifecycleChange[]
  history      EmpEmployeeHistory[]

  @@index([status, name])
  @@map("emp_employees")
}

// Durable operation doubles as the transactional outbox for this one workflow.
model EmpProvisioning {
  id             String                @id @db.Char(36)
  employeeId     String                @unique @map("employee_id") @db.Char(36)
  actorAccountId String                @map("actor_account_id") @db.Char(36)
  requestId      String?               @map("request_id") @db.Char(36)
  payloadHash    String                @map("payload_hash") @db.Char(64)
  email          String                @db.VarChar(254)
  desiredStatus  EmpEmployeeStatus     @map("desired_status")
  status         EmpProvisioningStatus @default(PENDING)
  phase          EmpProvisioningPhase  @default(PREPARE)
  authAccountId  String?               @map("auth_account_id") @db.Char(36)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now()) @map("next_attempt_at") @db.DateTime(3)
  leaseUntil     DateTime?             @map("lease_until") @db.DateTime(3)
  leaseToken     String?               @map("lease_token") @db.Char(36)
  errorCode      String?               @map("error_code") @db.VarChar(40)
  createdAt      DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  employee       EmpEmployee           @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, nextAttemptAt, leaseUntil])
  @@index([actorAccountId, createdAt])
  @@map("emp_provisioning")
}

model AuthProvisioning {
  id                  String      @id @db.Char(36)
  accountId           String      @unique @map("account_id") @db.Char(36)
  actorAccountId      String      @map("actor_account_id") @db.Char(36)
  payloadHash         String      @map("payload_hash") @db.Char(64)
  finalized           Boolean     @default(false)
  credentialEnvelope  String?     @map("credential_envelope") @db.VarChar(512)
  credentialClaimedAt DateTime?   @map("credential_claimed_at") @db.DateTime(3)
  createdAt           DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.DateTime(3)
  account             AuthAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("auth_provisioning")
}

model EmpEmployeeHistory {
  id             String      @id @default(uuid()) @db.Char(36)
  employeeId     String      @map("employee_id") @db.Char(36)
  actorAccountId String      @map("actor_account_id") @db.Char(36)
  action         String      @db.VarChar(80)
  before         Json
  after          Json
  requestId      String?     @map("request_id") @db.Char(36)
  createdAt      DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  employee       EmpEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([employeeId, createdAt])
  @@map("emp_employee_history")
}

model EmpEmailChange {
  id             String                @id @db.Char(36)
  employeeId     String                @map("employee_id") @db.Char(36)
  actorAccountId String                @map("actor_account_id") @db.Char(36)
  expectedEmail  String                @map("expected_email") @db.VarChar(254)
  email          String                @db.VarChar(254)
  payloadHash    String                @map("payload_hash") @db.Char(64)
  status         EmpProvisioningStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now()) @map("next_attempt_at") @db.DateTime(3)
  leaseUntil     DateTime?             @map("lease_until") @db.DateTime(3)
  leaseToken     String?               @map("lease_token") @db.Char(36)
  errorCode      String?               @map("error_code") @db.VarChar(40)
  requestId      String?               @map("request_id") @db.Char(36)
  createdAt      DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  employee       EmpEmployee           @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, nextAttemptAt, leaseUntil])
  @@index([employeeId, createdAt])
  @@map("emp_email_changes")
}

model EmpLifecycleChange {
  id             String                @id @db.Char(36)
  employeeId     String                @map("employee_id") @db.Char(36)
  actorAccountId String                @map("actor_account_id") @db.Char(36)
  expectedStatus EmpEmployeeStatus     @map("expected_status")
  targetStatus   EmpEmployeeStatus     @map("target_status")
  payloadHash    String                @map("payload_hash") @db.Char(64)
  status         EmpProvisioningStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now()) @map("next_attempt_at") @db.DateTime(3)
  leaseUntil     DateTime?             @map("lease_until") @db.DateTime(3)
  leaseToken     String?               @map("lease_token") @db.Char(36)
  errorCode      String?               @map("error_code") @db.VarChar(40)
  requestId      String?               @map("request_id") @db.Char(36)
  createdAt      DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  employee       EmpEmployee           @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, nextAttemptAt, leaseUntil])
  @@index([employeeId, createdAt])
  @@map("emp_lifecycle_changes")
}

model AuthEmailChange {
  id             String      @id @db.Char(36)
  accountId      String      @map("account_id") @db.Char(36)
  actorAccountId String      @map("actor_account_id") @db.Char(36)
  payloadHash    String      @map("payload_hash") @db.Char(64)
  email          String      @db.VarChar(254)
  createdAt      DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  account        AuthAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([accountId, createdAt])
  @@map("auth_email_changes")
}